rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /vault_submissions/{submissionId} {
      allow create: if request.resource.data.paymentStatus == "pending";
      allow update: if request.auth != null || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paidAt']) &&
        request.resource.data.paymentStatus == 'paid'
      );
      allow read, delete: if request.auth != null;
    }

    match /customers/{email} {
      // Allow post-checkout upsert from /thank-you
      allow create, update: if true;
      // Only authenticated CRM admins can view or export the customer list
      allow read, delete: if request.auth != null;
    }
  }
}
